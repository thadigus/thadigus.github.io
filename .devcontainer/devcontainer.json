{
  "name": "Thadigus Blog Site Devcontainer",
  "workspaceFolder": "/workspaces/thadigus-blog",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "terminal.integrated.cwd": "/workspaces/thadigus-blog"
      }
    }
  },
  "forwardPorts": [4000, 35729],
  "postCreateCommand": "git config --global --add safe.directory /workspaces/thadigus-blog && bundle install",
  "postStartCommand": "nohup bundle exec jekyll serve -H 0.0.0.0 -P 4000 --livereload > /tmp/jekyll.log 2>&1 < /dev/null &",
  "remoteUser": "root"
}
